# ==============================================================================
# AL BUSINESS OS — Variáveis de Ambiente (Exemplo)
# Copie para `.env` na raiz do projeto. NUNCA faça commit do `.env`.
# ==============================================================================

# --- Aplicação ---
NODE_ENV=development
APP_NAME="AL Business OS"
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001

# --- Banco de Dados (PostgreSQL + pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=al_os_user
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=al_business_os
DATABASE_URL=postgresql://al_os_user:change_me_dev_password@localhost:5432/al_business_os

# --- Cache & Filas (Redis / BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Storage S3-Compatible (RustFS dev / Cloudflare R2 ou AWS S3 prod) ---
S3_ENDPOINT=http://localhost:9000
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_BUCKET=al-business-os-private
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=change_me_s3_secret

# --- Segurança, Auth & Criptografia (GERAR NOVAS CHAVES EM PRODUÇÃO) ---
BETTER_AUTH_SECRET=replace_with_32_plus_chars_random_secret_key
ENCRYPTION_KEY=replace_with_64_hex_chars_aes_256_gcm_key
JWT_ISSUER=al-business-os

# --- IA Local-First (Ollama / LM Studio / Faster-Whisper) ---
# Para usar Ollama instalado fora do Docker no Windows, use http://host.docker.internal:11434
AI_DEFAULT_PRIVACY_MODE=strict_local
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_REASONING_MODEL=qwen2.5:14b
OLLAMA_EMBEDDING_MODEL=bge-m3

WHISPER_PORT=8000
WHISPER_BASE_URL=http://localhost:8000/v1
WHISPER_MODEL=small

# --- IA Cloud Fallback (Opcional — usado apenas quando permitido pela política) ---
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# --- WhatsApp Adapter (Evolution API no MVP / Meta Cloud API no SaaS) ---
WHATSAPP_PROVIDER=evolution
EVOLUTION_PORT=8080
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change_me_evolution_api_key
WHATSAPP_DEBOUNCE_MS=4000

# Meta Cloud API (Opcional / SaaS)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_WEBHOOK_VERIFY_TOKEN=

# --- Pagamentos (Asaas Adapter — opcional em dev, usa sandbox local se vazio) ---
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=change_me_asaas_webhook_token

# --- Observabilidade (Opcional) ---
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
