{
  "$schema": "https://tr.designtokens.org/format/",
  "brand": "AL Business OS",
  "themeName": "Atelier Obsidian & Mineral Paper",
  "color": {
    "light": {
      "background": "#F7F6F2",
      "surface": "#FFFFFF",
      "surfaceMuted": "#EFECE4",
      "border": "#E5E3DC",
      "textPrimary": "#18181B",
      "textSecondary": "#52525B",
      "textMuted": "#71717A",
      "accent": "#0D9488",
      "accentHover": "#0F766E",
      "accentForeground": "#FFFFFF",
      "copper": "#D97706",
      "success": "#059669",
      "warning": "#D97706",
      "danger": "#E11D48",
      "info": "#0284C7"
    },
    "dark": {
      "background": "#09090B",
      "surface": "#111114",
      "surfaceMuted": "#18181D",
      "border": "#25252B",
      "textPrimary": "#F4F4F5",
      "textSecondary": "#A1A1AA",
      "textMuted": "#71717A",
      "accent": "#14B8A6",
      "accentHover": "#2DD4BF",
      "accentForeground": "#042F2E",
      "copper": "#F59E0B",
      "success": "#10B981",
      "warning": "#F59E0B",
      "danger": "#F43F5E",
      "info": "#38BDF8"
    }
  },
  "typography": {
    "fontDisplay": "Plus Jakarta Sans, Inter, system-ui, sans-serif",
    "fontSans": "Inter, system-ui, sans-serif",
    "fontMono": "JetBrains Mono, ui-monospace, monospace",
    "scale": {
      "display": { "size": "3.25rem", "lineHeight": "1.06", "weight": "700" },
      "h1": { "size": "1.75rem", "lineHeight": "1.2", "weight": "650" },
      "h2": { "size": "1.375rem", "lineHeight": "1.25", "weight": "600" },
      "h3": { "size": "1rem", "lineHeight": "1.35", "weight": "600" },
      "body": { "size": "0.875rem", "lineHeight": "1.5", "weight": "400" },
      "bodyLg": { "size": "1rem", "lineHeight": "1.6", "weight": "400" },
      "caption": { "size": "0.75rem", "lineHeight": "1.4", "weight": "500" }
    }
  },
  "spacing": {
    "unit": "4px",
    "scale": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px"
    }
  },
  "radius": {
    "sm": "8px",
    "md": "10px",
    "lg": "14px",
    "xl": "18px",
    "full": "9999px"
  },
  "motion": {
    "fast": "150ms cubic-bezier(0.16, 1, 0.3, 1)",
    "base": "220ms cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
